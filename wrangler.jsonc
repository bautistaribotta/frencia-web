// Deploy en Cloudflare Workers, solo archivos estaticos: la web es una SPA y
// todo lo demas va a Supabase. Cloudflare compila con `npm run build` y sirve
// dist/. Con single-page-application, cualquier ruta que no sea un archivo
// devuelve index.html y React Router resuelve la pagina, asi que recargar
// /historial/:id no da 404.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frencia-web",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
